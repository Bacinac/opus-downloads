# Copy to .env. Only infra bootstrap lives here — engine configuration (modes,
# URLs, credentials) is set at runtime through the app's Settings page and stored
# in Postgres.

# Where OPUS · Library answers, and the token it is asked with (the Downloads
# token on Library's account page). Required: Library keeps the roster this
# module guards with, and checks every password typed here. The backend refuses
# to start without either. For a Library on the same machine:
#   OPUS_AUTH_URL=http://192.0.2.10:8095
OPUS_AUTH_URL=
OPUS_AUTH_TOKEN=

# What sessions are signed with. Required, and the SAME value in Library,
# Downloads and Player: a session any of them issues is read by all three.
#   python -c "import secrets; print(secrets.token_hex(32))"
OPUS_SESSION_KEY=

# The database password, set in Postgres and in the backend's connection. It is
# part of a URL, so hex only. An existing database keeps the password it was
# created with: change it there first (ALTER ROLE opus PASSWORD '…').
#   python -c "import secrets; print(secrets.token_hex(32))"
POSTGRES_PASSWORD=

# The origin the bundled engines' own interfaces are opened on — the engine-ui
# service, published on 8099. Required once any engine runs bundled; the backend
# refuses to start without it then. Scheme and host only, no path.
#   through a tunnel: OPUS_ENGINES_URL=https://engines.example.com
#   on the LAN:       OPUS_ENGINES_URL=http://192.0.2.10:8099
OPUS_ENGINES_URL=

# UID/GID used by the web backend and engine UI. The landing and engine-config
# volumes must be owned by this identity before switching an existing install.
# OPUS_APP_UID=1000
# OPUS_APP_GID=1000
# First review `./deploy/prod.sh --prepare-volumes`; run it with `--apply`
# only in the planned rollout that enables the non-root backend.

# Numeric group that owns OPUS_DOCKER_SOCKET on the Docker host. The
# docker-controller runs as OPUS_APP_UID and receives only this supplementary
# group; check it with `stat -c %g /var/run/docker.sock` on a new host.
# OPUS_DOCKER_GID=991

# The domain the three modules share a session on, when they are published
# under one (opus.example.com and library.example.com share example.com).
# Unset keeps the cookie on the host that issued it — right for a LAN address.
# OPUS_COOKIE_DOMAIN=example.com

# Dev shapes (Vite dev server + HMR, uvicorn --reload). Leave unset for
# production: built UI (adapter-node + /api proxy) and plain uvicorn.
# OPUS_UI_TARGET=dev
# OPUS_DEV_RELOAD=1
# The hostname a tunnel publishes the dev server at, when it is opened from
# beyond the LAN; hot reload then runs over the tunnel's TLS as well.
# OPUS_DEV_HOST=opus-dev.example.com

# Container resource ceilings. Defaults fit the application services on the
# 32 GiB host; increase only the role whose measured workload requires it.
# OPUS_BACKEND_MEMORY_LIMIT=2g
# OPUS_BACKEND_PIDS_LIMIT=512
# OPUS_CONTROLLER_MEMORY_LIMIT=512m
# OPUS_CONTROLLER_PIDS_LIMIT=128
# OPUS_ENGINE_UI_MEMORY_LIMIT=512m
# OPUS_ENGINE_UI_PIDS_LIMIT=128
# OPUS_FRONTEND_MEMORY_LIMIT=512m
# OPUS_FRONTEND_PIDS_LIMIT=128
# OPUS_DATABASE_MEMORY_LIMIT=2g
# OPUS_DATABASE_PIDS_LIMIT=128

# Bundled engines are created through Docker's API, which takes byte counts.
# Their VPN tunnels have smaller limits because they only carry network traffic.
# OPUS_ENGINE_MEMORY_LIMIT_BYTES=2147483648
# OPUS_ENGINE_PIDS_LIMIT=256
# OPUS_VPN_MEMORY_LIMIT_BYTES=536870912
# OPUS_VPN_PIDS_LIMIT=128

# The media tree, as the Docker host sees it, that a bundled engine may share
# back to its network (slskd's share directory must be inside it). Unset,
# nothing is shared. For example:
# OPUS_MEDIA_HOST_DIR=/mnt/media

# Landing zone (compose named volume). Unset falls back to the in-repo
# ./volumes/landing folder.
#
# A download tree on this machine — bind it, read-write:
# OPUS_LANDING_VOLUME_TYPE=none
# OPUS_LANDING_VOLUME_OPTS=bind
# OPUS_LANDING_DEVICE=/mnt/download

# The front proxies this box is reached through (for example a Cloudflare
# tunnel connector and a reverse proxy on the LAN).
# Only from them is a forwarded client address believed; every other caller is
# known by its own socket address.
# OPUS_TRUSTED_PROXIES=192.0.2.100,192.0.2.101
